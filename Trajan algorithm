
class Solution {
  private:
    int timer = 0;
    
    void dfs(int node,int parent,vector<int> adj[],vector<int>& vis,int tin[],int low[],vector<int>& mark){
        vis[node] = 1;
        low[node] = tin[node] = timer;
        timer++;
        int child = 0;
        
        for(auto it:adj[node]){
            if(!vis[it]){
                dfs(it,node,adj,vis,tin,low,mark);
                low[node] = min(low[it],low[node]);
                if(low[it] >= tin[node] && parent != -1){
                    mark[node] = 1;
                }
                child++;
            }
            else{
                // checking for the back edge
                if(it == parent)    continue;
                low[node] = min(low[node],tin[it]);
            }
        }
        if(child > 1 && parent == -1){
            mark[node] = 1;
        }
    }
  public:
    vector<int> articulationPoints(int V, vector<int>adj[]) {
        vector<int> vis(V,0);
        int tin[V];
        int low[V];
        vector<int> mark(V,0);
        for(int i=0;i<V;i++){
            if(!vis[i])
                dfs(i,-1,adj,vis,tin,low,mark);
        }
        vector<int> ans;
        for(int i=0;i<V;i++){
            if(mark[i] == 1){
                ans.push_back(i);
            }
        }
        if(ans.size() == 0) return {-1};
        return ans;
    }
};


// bridges in a graph
// Note :- bascically time of insertion and lowest time (lowest time among the adjacent nodes)
// se hum bina tode same time of inseration ke components bna sakte hai such that the nodes having same
// time of insertion can reach to each other 

class Solution {
    int timer = 1;
    void dfs(int node,int parent,vector<int> adj[],vector<int>& vis,int tim[],int low[],vector<vector<int>>& bridge){
        vis[node] = true;
        tim[node] = low[node] = timer;
        timer++;
        for(auto it:adj[node]){
            if(it == parent){
                continue;
            }
            if(!vis[it]){
                dfs(it,node,adj,vis,tim,low,bridge);
                low[node] = min(low[node],low[it]);
                // is node ---- it can be a bridge
                if(low[it] > tim[node]){
                    bridge.push_back({it,node});
                }
            }
            else{
                low[node] = min(low[node],low[it]);
            }
        }
    }
public:
    vector<vector<int>> criticalConnections(int n, vector<vector<int>>& connections) {
        vector<int> adj[n];
        for(auto it:connections){
            adj[it[0]].push_back(it[1]);
            adj[it[1]].push_back(it[0]);
        }
        vector<int> vis(n,0);
        int tim[n];
        int low[n];
        vector<vector<int>> bridge;
        dfs(0,-1,adj,vis,tim,low,bridge);
        return bridge;
    }
};
